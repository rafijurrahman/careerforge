# CareerForge Terminal Demo: Offline Knapsack Tailoring & --diff (vhs)
# To render: vhs demo/tailor.tape

Output demo/tailor.gif

Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 720
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set Margin 20

Type "forge tailor --jd examples/sample_jd.txt --profile examples/profile.example.yaml --diff --pages 1"
Sleep 500ms
Enter
Sleep 5s

Type "# Bullets ranked strictly from Alex Rivera's real profile.yaml!"
Sleep 2s
